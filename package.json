{
  "name": "sonora",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/copy-pdfium.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "portraits": "node ./scripts/download-composer-portraits.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "pretauri:build": "tauri icon ./src-tauri/icons/app-icon.svg",
    "tauri:build": "node ./scripts/tauri-build.mjs",
    "postinstall": "node ./scripts/copy-pdfium.mjs",
    "test:library": "node scripts/test-library.mjs",
    "test:practice": "node scripts/test-practice.mjs",
    "bench:library": "node scripts/bench-library.mjs",
    "test:performance": "node scripts/test-performance.mjs",
    "bench:compare": "node scripts/compare-benchmarks.mjs",
    "test:pdf": "node scripts/test-pdf-scheduler.mjs && node scripts/test-folder-thumbnails.mjs",
    "test:handwriting": "node scripts/test-handwriting-model.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "prettier-plugin-svelte": "^3.2.2",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@embedpdf/engines": "^2.15.0",
    "@embedpdf/pdfium": "^2.15.0",
    "@lucide/svelte": "^1.34.0",
    "@tauri-apps/api": "^2",
    "dexie": "^4.4.5",
    "onnxruntime-web": "1.30.0"
  }
}
